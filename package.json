{
  "name": "amrita-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "A multi-floor map of Amrita Vishwa Vidyapeetam, Bengaluru — buildings, rooms, canteens and walking routes, from community-curated data.",
  "license": "MIT",
  "scripts": {
    "build:data": "bun scripts/build-data.mjs",
    "dev": "bun run build:data && vite",
    "build": "bun run build:data && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "bun scripts/smoke.mjs",
    "test": "bun run typecheck && bun run build:data && bun run smoke",
    "verify": "bun scripts/verify-browser.mjs"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^20.4.0",
    "esbuild": "^0.21.5",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "maplibre-gl-draw": "1.6.9"
  },
  "homepage": "https://map.amrita.town",
  "repository": {
    "type": "git",
    "url": "https://github.com/nithitsuki/map.amrita.town.git"
  }
}
